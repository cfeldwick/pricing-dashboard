{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "PricingDashboard": "Information"
    }
  },
  "Solace": {
    "Enabled": true,
    "Host": "tcp://solace-broker.prod.internal:55555",
    "VpnName": "production",
    "UseKerberos": true,
    "KerberosServiceName": "solace",
    "ConnectTimeoutMs": 10000,
    "ReconnectRetries": 5,
    "ReconnectRetryIntervalMs": 5000,
    "RequestCachedMessages": true
  }
}
